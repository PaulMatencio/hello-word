# Gemini AI Copilot API Key (Google AI Studio)
GEMINI_API_KEY=

# Persistence Driver: 'file' (default) or 'redis-json'
STORAGE_DRIVER=file

# Redis Stack Connection (if using STORAGE_DRIVER=redis-json)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=midnight:

# Private State Encryption Password (must be at least 16 characters)
PRIVATE_STATE_PASSWORD=Midnight-Studio-Secret-Key-16+

# Optional Custom Endpoints
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.1am.xyz
# MIDNIGHT_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
