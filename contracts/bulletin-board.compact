pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  VACANT,
  OCCUPIED
}

export ledger state: State;
export ledger message: Maybe<Opaque<"string">>;
export ledger sequence: Counter;
export ledger owner: Bytes<32>;

// Private witness function supplying caller's secret key
witness localSecretKey(): Bytes<32>;

/**
 * Initializes the bulletin board to VACANT state with sequence counter at 1.
 */
constructor() {
  state = State.VACANT;
  message = none<Opaque<"string">>();
  owner = pad(32, "");
  sequence.increment(1);
}

/**
 * Internal helper to derive an owner verification tag in ZK.
 */
circuit deriveOwnerTag(sk: Bytes<32>, seq: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "bboard:pk:"), 
    seq, 
    sk
  ]);
}

/**
 * Posts a message to a VACANT board or updates the message if called by the current owner.
 */
export circuit postMessage(newMessage: Opaque<"string">): [] {
  const currentSeq = sequence as Field as Bytes<32>;
  const calculatedTag = deriveOwnerTag(localSecretKey(), currentSeq);

  if (state == State.VACANT) {
    // Claim board and set initial owner tag
    owner = disclose(calculatedTag);
    message = disclose(some<Opaque<"string">>(newMessage));
    state = State.OCCUPIED;
  } else {
    // Board is OCCUPIED: verify existing ownership
    assert(owner == calculatedTag, "Only the current owner can edit the post");
    
    // Update message
    message = disclose(some<Opaque<"string">>(newMessage));
    
    // Advance sequence and update owner tag for forward privacy/unlinkability
    sequence.increment(1);
    const nextSeq = sequence as Field as Bytes<32>;
    owner = disclose(deriveOwnerTag(localSecretKey(), nextSeq));
  }
}

/**
 * Takes down an existing post. Only callable by the current owner.
 */
export circuit takeDown(): Opaque<"string"> {
  assert(state == State.OCCUPIED, "Attempted to take down post from an empty board");
  
  const currentSeq = sequence as Field as Bytes<32>;
  const expectedTag = deriveOwnerTag(localSecretKey(), currentSeq);
  assert(owner == expectedTag, "Attempted to take down post, but not the current owner");
  assert(message.is_some, "Corrupted state: post is occupied but message is empty");

  const formerMsg = message.value;
  
  state = State.VACANT;
  message = none<Opaque<"string">>();
  owner = pad(32, "");
  sequence.increment(1);

  return formerMsg;
}